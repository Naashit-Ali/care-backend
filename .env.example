PORT=3000
HOST=0.0.0.0
# Your ngrok URL (e.g. https://pillpal.ngrok-free.app). Only used for logs; the app reads its own copy in frontend/.env
PUBLIC_URL=
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>/medicare
# Comma-separated list of allowed origins, or *
CORS_ORIGIN=*
# true when running behind ngrok/any proxy, so rate limiting sees the real client IP
TRUST_PROXY=true
TZ=Europe/Budapest
MISSED_GRACE_MINUTES=15
# How early a parent can tap TAKEN (minutes before the scheduled time)
TAKE_WINDOW_BEFORE_MINUTES=15
PAIRING_CODE_TTL_MINUTES=15

# Phase 2 — AI care agent
# Provider: auto (Gemini first, then Anthropic) | google | anthropic
LLM_PROVIDER=auto
# Free: https://aistudio.google.com/apikey → create key → paste here
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional paid/credits: https://console.anthropic.com → API keys
ANTHROPIC_API_KEY=
# Optional: ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
